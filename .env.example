# =============================================================================
# VARIABLES DE ENTORNO PARA NEXT.JS (WEB ADMIN) - CAMPUS SABOR
# Copia este archivo como .env.local en la carpeta web/
# =============================================================================

# URL pública del proyecto Supabase (accesible en browser y servidor)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública de Supabase (accesible en browser y servidor, restringida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CLAVE MAESTRA PRIVILEGIADA DE SERVICIO (NUNCA EXPONER AL CLIENTE / NAVEGADOR)
# Exclusiva para Server Actions y scripts de administración en el servidor Node.js
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
